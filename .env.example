# ================================
# WhatsApp AI Bot — Environment
# ================================
# Copy this file to .env and fill in your values

# --- WAHA ---
WAHA_API_KEY=changeme123

# --- n8n ---
N8N_SECURE_COOKIE=false
N8N_HOST=0.0.0.0
N8N_PORT=5678

# --- Ollama ---
# Set this on Windows host before starting Ollama:
# setx OLLAMA_HOST "0.0.0.0:11434" /M
OLLAMA_HOST_IP=192.168.1.100   # Your Windows/host machine IP

# --- Obsidian Local REST API ---
OBSIDIAN_API_KEY=your_obsidian_api_key_here
OBSIDIAN_HOST=192.168.1.100    # IP of machine running Obsidian
OBSIDIAN_PORT=27124
OBSIDIAN_VAULT_PATH=Reservations

# --- Network ---
# Docker bridge IP (for WAHA webhook → n8n)
DOCKER_BRIDGE_IP=172.17.0.1
